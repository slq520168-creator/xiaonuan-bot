{
  "name": "xiaonuan-bot",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "CHAT_API_PRIMARY": "https://youxuansi.online/role-chat",
    "PUBLIC_BASE_URL": "https://xiaonuan-bot.slq520168.workers.dev"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHATS",
        "class_name": "BotChat"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BotChat"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
